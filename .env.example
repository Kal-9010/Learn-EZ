# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored (see .gitignore's `*.local` rule) — never commit real keys.

# Public by design — Supabase's anon key is safe to expose client-side as
# long as Row Level Security is enabled on every table (PRD section 8).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — deliberately NOT prefixed with VITE_, so Vite never bundles
# it into client JS. Only read by src/server/groqHandler.js (via the Vercel
# serverless function api/groq.js, or the Vite dev middleware locally).
GROQ_API_KEY=
